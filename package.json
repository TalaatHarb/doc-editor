{
  "name": "doc-editor",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter sample-fe dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint packages apps/sample-fe/src",
    "format": "prettier --check packages/*/src apps/sample-fe/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  }
}
